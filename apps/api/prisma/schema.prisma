generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Throwaway model — proves the migration pipeline works end-to-end.
// Deleted once Phase 1 introduces the real schema (Tenant, User, ...).
model Ping {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
