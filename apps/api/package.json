{
  "name": "@inventra/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.mts\" && depcruise --config .dependency-cruiser.cjs src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-fastify": "^11.1.28",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.11.3",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@inventra/eslint-config": "workspace:*",
    "@inventra/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^24.13.3",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
