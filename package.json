{
  "name": "inventra",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:domain": "turbo run test:domain",
    "db:migrate": "pnpm --filter @inventra/api db:migrate",
    "db:seed": "pnpm --filter @inventra/api db:seed",
    "db:generate": "pnpm --filter @inventra/api db:generate",
    "db:studio": "pnpm --filter @inventra/api db:studio"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  }
}
